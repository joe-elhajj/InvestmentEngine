<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.joeelhajj.investmentengine</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/joeelhajj/Projects/Investment Engine/app/launcher.sh</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/joeelhajj/.investment_engine/server.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/joeelhajj/.investment_engine/server.log</string>

    <!--
      No EnvironmentVariables key here on purpose: ANTHROPIC_API_KEY must
      never be committed to this repo. INSTALL.md's "Auto-start at login"
      step merges an EnvironmentVariables dict into the COPY of this file
      in ~/Library/LaunchAgents (not this tracked template) from a
      gitignored, outside-the-repo file at ~/.investment_engine/env.plist,
      via `plutil`/`PlistBuddy Merge`. launchd sets that env on this job's
      process, which launcher.sh's exec then inherits down to uvicorn —
      no code change needed in launcher.sh itself for the key to reach it.
    -->
</dict>
</plist>
